# 실제 값은 여기 적지 말고, Vercel → Settings → Environment Variables 에 넣으세요.
# 쓸 기능에 해당하는 것만 채우면 됩니다.

# 프록시 접근 암호. 직접 만드는 값이며 API 회사에서 받는 키가 아닙니다.
# 24자 이상 무작위 문자열을 권장합니다. 앱의 "키" 칸에도 같은 값을 넣습니다.
PROXY_KEY=

# 채팅 — OpenAI 호환 제공자 (Cerebras, OpenRouter 등)
UPSTREAM_URL=
UPSTREAM_KEY=

# 채팅 — GemTi (Antigravity)
AGY_REFRESH_TOKEN=
AGY_PROJECT_ID=
AGY_THINKING=low

# 채팅 — Vertex AI (구글 클라우드 서비스 계정)
# 서비스 계정 JSON 파일을 받아서, 그 안의 값을 옮겨 적습니다.
# 모델명은 앱에서 vertex/gemini-3.6-flash 처럼 vertex/ 를 앞에 붙여 씁니다.
VERTEX_PROJECT_ID=
VERTEX_CLIENT_EMAIL=
# -----BEGIN PRIVATE KEY----- 부터 -----END PRIVATE KEY----- 까지 통째로
VERTEX_PRIVATE_KEY=
# 최신 모델은 global 이라야 붙습니다. 비워두면 us-central1 입니다.
VERTEX_LOCATION=global

# 이미지 — GPT
OPENAI_KEY=

# 이미지 — NovelAI
NAI_TOKEN=

# 동기화 — Vercel Storage 에서 Blob 을 만들면 자동으로 채워집니다
BLOB_READ_WRITE_TOKEN=
